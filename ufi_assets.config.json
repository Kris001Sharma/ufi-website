{
  "_readme": "Central asset map for the UFI site. Every image/video used in a page is looked up by key from here — never hardcode a Cloudinary URL in a component. Swapping a photo means editing one 'publicId' below, not touching code.",

  "cdn": {
    "provider": "cloudinary",
    "cloudName": "devkrish",
    "defaultTransform": "f_auto,q_auto",
    "note": "f_auto,q_auto lets Cloudinary auto-serve WebP/AVIF and compress per-browser. Always append this unless a specific override is needed."
  },

  "video": {
    "provider": "youtube",
    "youtubeId": "REPLACE_WITH_YOUTUBE_ID",
    "note": "Full cinematic case-study video. Loaded via a click-to-play facade — see hero demo. Never auto-embedded, so it never adds weight to first load."
  },

  "assets": {
